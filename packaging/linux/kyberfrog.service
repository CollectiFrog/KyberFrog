# KyberFrog systemd *user* service.
#
# Installed to /usr/lib/systemd/user/ and enabled for every user by the .deb
# postinst (`systemctl --global enable kyberfrog.service`). It is a user service
# (not system) on purpose: a viewer's kyclient must run inside the graphical
# session to open a fullscreen window, and screen-capture transmitters need the
# session's display too.
#
# Headless display box: ensure the box auto-logs into a graphical seat (a
# minimal compositor / DRM-KMS session) so graphical-session.target comes up.

[Unit]
Description=KyberFrog — low-latency LAN video transmitters & viewers (QUIC)
Documentation=https://kyber-frog.gitlab.io/kyberfrog/
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/lib/kyberfrog/bin/kyberfrog
Restart=on-failure
RestartSec=2
# Reap the whole process tree (kycontroller / kyclient children) when the
# service stops or crashes — the Linux analogue of the Windows Job Object.
KillMode=control-group

[Install]
WantedBy=graphical-session.target
