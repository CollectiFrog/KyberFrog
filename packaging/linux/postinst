#!/bin/sh
# KyberFrog .deb post-install.
set -e

case "$1" in
  configure)
    # Put the bundled fork libraries on the system linker path. KyberFrog also
    # hands its spawned children an explicit LD_LIBRARY_PATH, so this is mainly
    # belt-and-braces (and lets the binaries be run by hand).
    #
    # The multiarch sub-directory matters: libtxproto / libkyclient / libkynput
    # and the FFmpeg libraries live in lib/<triplet>, not directly in lib/.
    # Listing only lib/ leaves kyavserver and kyclient unable to start.
    # Enumerated rather than guessed from the architecture: no dependency on
    # dpkg-dev, and it stays correct whatever the bundle actually ships.
    {
        echo /usr/lib/kyberfrog/lib
        for dir in /usr/lib/kyberfrog/lib/*/; do
            [ -d "$dir" ] || continue
            case "$dir" in */vlc/) continue ;; esac   # plugins, not a link path
            echo "${dir%/}"
        done
        [ -d /usr/lib/kyberfrog/lib64 ] && echo /usr/lib/kyberfrog/lib64
    } > /etc/ld.so.conf.d/kyberfrog.conf
    ldconfig || true

    # Autostart at graphical login for every user. It is a *user* unit: kyclient
    # needs the graphical session to open its fullscreen window.
    systemctl --global enable kyberfrog.service >/dev/null 2>&1 || true

    # Remote control (a viewer taking over the remote desktop) injects mouse
    # buttons and keystrokes through /dev/uinput. Load the module now so the
    # node exists without a reboot, and apply the shipped udev rule to the
    # already-present node — udev only replays rules on device events, so a
    # trigger is needed for this install to take effect immediately.
    modprobe uinput >/dev/null 2>&1 || true
    udevadm control --reload-rules >/dev/null 2>&1 || true
    udevadm trigger --subsystem-match=misc --sysname-match=uinput >/dev/null 2>&1 || true

    echo "KyberFrog installed. Open http://localhost:7700/ after logging into a"
    echo "graphical session, or start it now with:  systemctl --user start kyberfrog"
    echo ""
    echo "Remote control (taking over this machine from a viewer) also needs your"
    echo "user to be in the 'input' group, for write access to /dev/uinput:"
    echo "    sudo usermod -aG input \$USER      # then log out and back in"
    echo "Without it the remote pointer moves but never clicks or types."
    ;;
esac

exit 0
